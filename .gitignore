stream-*.txt
*.proto
*.desc

# Keys and secrets
.env*
*.pem
*.key
*.jks
*.p12
*.pfx

# Logs and JVM dumps
*.log
*.hprof
hs_err_pid*

# OS files
.DS_Store
Thumbs.db
desktop.ini
